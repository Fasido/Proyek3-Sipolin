generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 👑 ENUM ROLE — Biar manajemen user lo nggak typo
enum Role {
  USER
  DRIVER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  name           String
  nim            String    @unique
  phone          String?
  role           Role      @default(USER) // ✅ Sekarang pake Enum
  ktmImage       String?
  isVerified     Boolean   @default(false)
  vehicleInfo    String?
  plateNumber    String?
  vehicleDetail  String?
  avatar         String?
  profilePicture String?

  // ── Real-Time Location ─────────────
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──────────────────────
  orders             Order[]        @relation("customer")
  tripsAsDriver      Order[]        @relation("driver")
  notifications      Notification[]
  chatRoomsAsCustomer ChatRoom[]     @relation("chatCustomer")
  chatRoomsAsDriver   ChatRoom[]     @relation("chatDriver")
  sentMessages       Message[]      @relation("messageSender")
  broadcasts         Broadcast[]    // ✅ Link ke history broadcast admin
  aiChats             AiChat[]

  @@map("users")
}

model Order {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  price       Float    @default(0)
  status      String   @default("pending")
  pickup      String
  destination String

  customerId String
  customer   User   @relation("customer", fields: [customerId], references: [id], onDelete: Cascade)

  driverId String?
  driver   User?   @relation("driver", fields: [driverId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  chatRoom ChatRoom?

  @@map("orders")
}

model Notification {
  id             String   @id @default(cuid())
  title          String
  message        String
  type           String
  isRead         Boolean  @default(false)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedOrderId String?
  createdAt      DateTime @default(now())

  @@map("notifications")
}

// 📢 BROADCAST — Singasana buat kirim pengumuman massal
model Broadcast {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  target    String   @default("all") // all, user, driver
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())

  @@map("broadcasts")
}

// 💬 CHAT MODELS
model ChatRoom {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User     @relation("chatCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  driverId     String
  driver       User     @relation("chatDriver", fields: [driverId], references: [id], onDelete: Cascade)
  lastMessage  String?
  lastMessageAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     Message[]

  @@index([customerId])
  @@index([driverId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("chat_rooms")
}

model Message {
  id         String   @id @default(cuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)
  text       String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([chatRoomId, createdAt(sort: Asc)])
  @@index([chatRoomId, senderId, isRead])
  @@map("messages")
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  category  String   // pedas, manis, makanan_berat, dessert, minuman
  menu      String
  location  String
  rating    Float    @default(0)
  price     Float?   // harga rata-rata
  imageUrl  String?  // foto restoran/makanan
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relasi ke rekomendasi AI
  recommendations FoodRecommendation[]
  
  @@map("restaurants")
}

model FoodRecommendation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id])
  prompt      String   @db.Text  // prompt user
  response    String   @db.Text  // response AI
  intentType  String   // taste, category, none
  intentValue String?  // pedas, manis, makanan_berat, dll
  isLiked     Boolean  @default(false) // user suka rekomendasi ini?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([restaurantId])
  @@index([createdAt(sort: Desc)])
  @@map("food_recommendations")
}